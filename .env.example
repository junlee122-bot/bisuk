# 브라우저가 접속하는 주소 (CSRF Origin 검사·CORS 허용 목록)
SEOKMUN_PUBLIC_ORIGIN=http://lab-server.example.ac.kr:3100
SEOKMUN_WEB_PORT=3100
# local(연구실 계정) | proxy-header(학교 SSO 리버스 프록시)
SEOKMUN_AUTH_MODE=local
# HTTPS 뒤에서는 1
SEOKMUN_COOKIE_SECURE=0
# 가상 데모 세트를 처음에 넣을지 (실사용 서버는 0 권장)
SEOKMUN_SEED_DEMO=0
# 선택: 첫 PI 계정 (비워 두면 웹 /setup 화면에서 생성)
SEOKMUN_BOOTSTRAP_ADMIN_EMAIL=
SEOKMUN_BOOTSTRAP_ADMIN_PASSWORD=
# SSO 모드
SEOKMUN_TRUSTED_PROXY_IPS=
SEOKMUN_PROXY_SHARED_SECRET=
